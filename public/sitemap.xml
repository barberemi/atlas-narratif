<?xml version="1.0" encoding="UTF-8"?>
<!--
  Routes statiques uniquement. Les articles de blog sont injectés au build par
  scripts/prerender.mjs (getSitemapEntries), qui n'inclut que les articles publiés
  (date de publication atteinte) — garde-fou dans src/data/blog/posts.js.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://DOMAIN_PLACEHOLDER/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://DOMAIN_PLACEHOLDER/login</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://DOMAIN_PLACEHOLDER/register</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://DOMAIN_PLACEHOLDER/blog</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://DOMAIN_PLACEHOLDER/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://DOMAIN_PLACEHOLDER/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
