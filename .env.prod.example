# ── Domaine ───────────────────────────────────────────────────────────────────
# Nom de domaine principal (sans https://)
DOMAIN=atlas.tondomain.com

# Email pour Let's Encrypt (certificat TLS automatique)
ACME_EMAIL=ton@email.com

# ── Traefik Dashboard ────────────────────────────────────────────────────────
# BasicAuth pour traefik.${DOMAIN}  (optionnel — laisser vide pour désactiver)
# Générer : docker run --rm httpd:2-alpine htpasswd -nBb admin 'mot-de-passe'
# Générer : htpasswd -nB admin   (garder les $ SIMPLES du hash bcrypt)
# ⚠ NE PAS doubler les $ ici : ce fichier est chargé comme variable d'env
#   (le doublage $$ ne vaut QUE pour un hash écrit en dur dans le compose YAML).
# ⚠ ENTOURER de guillemets simples : le Makefile source ce fichier, sinon le shell
#   interprète $2y → $2 (vide) et $$ → PID, ce qui casse le hash.
# Exemple : TRAEFIK_DASHBOARD_AUTH='admin:$2y$05$abcdef...'
TRAEFIK_DASHBOARD_AUTH=

# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-this-strong-password

# ── Better Auth ──────────────────────────────────────────────────────────────
# OBLIGATOIRE — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://atlas.tondomain.com

# ── Chiffrement au repos (RECOMMANDÉ en production) ─────────────────────────
# Chiffre les données narratives en base. Générer avec : openssl rand -base64 32
# ⚠ CONSERVER CETTE CLÉ — sans elle, les données chiffrées sont irrécupérables
ATLAS_ENCRYPTION_KEY=

# ── Google OAuth (optionnel) ─────────────────────────────────────────────────
# Laisser vide pour désactiver Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email transactionnel via Resend (optionnel) ──────────────────────────────
# Laisser vide pour afficher les emails dans les logs serveur
RESEND_API_KEY=
EMAIL_FROM=noreply@atlas.tondomain.com

# ── Chat de requête / LLM niveau 2 (optionnel) ───────────────────────────────
# 'mock' = simulé sans clé ; 'hosted' = endpoint OpenAI-compatible (Groq recommandé,
# gratuit). Repli auto sur mock si base_url/clé manquante ou erreur/timeout.
LLM_PROVIDER=hosted
LLM_BASE_URL=https://api.groq.com/openai
# Clé gratuite : https://console.groq.com
LLM_API_KEY=
# Modèle (ids évolutifs → GET {LLM_BASE_URL}/v1/models). Défaut multilingue rapide :
LLM_MODEL=qwen/qwen3.8-27b
# Garde-fous
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=512
LLM_RATE_LIMIT_PER_MIN=20
# Modèle à raisonnement (Qwen3, DeepSeek-R1…) : 'none' coupe le "thinking" (chaîne
# <think> longue et lente avant la réponse) → gros gain de latence sur Groq/Qwen3.
# Ne définir QUE pour un modèle raisonnant ; laisser vide/absent sinon.
# LLM_REASONING_EFFORT=none

# ── Retrieval sémantique du chat (embeddings, optionnel) ─────────────────────
# 'none' (défaut) = retrieval lexical. 'ollama' = embeddings via Ollama local
# (CPU, on-prem, aligné privacy). Repli lexical auto si Ollama indisponible.
EMBEDDINGS_PROVIDER=none
# OLLAMA_BASE_URL=http://ollama:11434
# Multilingue (FR) conseillé ; nomic-embed-text = anglophone, bge-m3 = + lourd.
# OLLAMA_EMBED_MODEL=paraphrase-multilingual
# EMBEDDINGS_TIMEOUT_MS=30000
# Durée où Ollama garde le modèle chargé en RAM (évite les cold-starts CPU). Défaut
# '30m'. '-1' = jamais décharger ; '0' = décharger aussitôt (défaut Ollama).
# OLLAMA_KEEP_ALIVE=30m

# ── Crisp (chat widget, optionnel) ──────────────────────────────────────────
# Laisser vide pour désactiver le chat
VITE_CRISP_WEBSITE_ID=
