# ── Base de données (OBLIGATOIRE) ─────────────────────────────────────────────
DATABASE_URL=postgresql://atlas:atlas_dev@localhost:5432/atlas

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3001

# ── Variables obligatoires ────────────────────────────────────────────────────
# L'API refuse de démarrer si l'une de ces variables est absente.
# URL du frontend (CORS + trustedOrigins)
FRONTEND_URL=http://localhost:5173
# Secret pour les sessions et le HMAC device — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-secret-in-production-min-32-chars
# URL publique du serveur (utilisée par Better Auth pour générer les liens)
BETTER_AUTH_URL=http://localhost:3001

# ── Google OAuth (optionnel) ──────────────────────────────────────────────────
# Laisser commenté pour désactiver Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Chiffrement au repos (optionnel en dev) ──────────────────────────────────
# Chiffre les données narratives en base. Générer avec : openssl rand -base64 32
# Si absent, les données sont stockées en clair.
# ATLAS_ENCRYPTION_KEY=

# ── Email transactionnel via Resend (optionnel) ──────────────────────────────
# Laisser commenté pour afficher les emails dans la console (mode dev)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@tondomain.com

# ── Chat de requête / LLM niveau 2 (optionnel) ───────────────────────────────
# 'mock' (défaut) = réponses simulées, AUCUNE clé requise (le niveau 1 déterministe
# ne dépend jamais du LLM). 'hosted' (ou groq/openrouter/gemini/mistral) = endpoint
# OpenAI-compatible. Si base_url ou clé manquante → repli automatique sur mock.
# LLM_PROVIDER=hosted
# Endpoint OpenAI-compatible. Groq (gratuit, rapide) recommandé :
# LLM_BASE_URL=https://api.groq.com/openai
# Clé API du fournisseur (Groq : https://console.groq.com — clé gratuite).
# LLM_API_KEY=
# Modèle. ⚠ Les ids évoluent — lister via GET {LLM_BASE_URL}/v1/models.
# Défaut Groq conseillé (multilingue, rapide) :
# LLM_MODEL=qwen/qwen3.8-27b
# Garde-fous (optionnels) : timeout ms, max tokens réponse, rate-limit/min/projet.
# LLM_TIMEOUT_MS=60000
# LLM_MAX_TOKENS=512
# LLM_RATE_LIMIT_PER_MIN=20

# ── Retrieval sémantique du chat (embeddings, optionnel) ─────────────────────
# 'none' (défaut) = retrieval lexical (recouvrement de mots), aucune dépendance.
# 'ollama' = embeddings via un serveur Ollama LOCAL (CPU, aucun tiers, aligné
# privacy). Repli automatique sur le lexical si Ollama est indisponible.
# Modèle conseillé : paraphrase-multilingual (~470 Mo) — MULTILINGUE, adapté au
# contenu FR. nomic-embed-text (~274 Mo) est plus léger mais surtout anglophone
# (résultats médiocres en FR) ; bge-m3 (~1,2 Go) est meilleur mais plus lourd.
#   ollama pull paraphrase-multilingual   (voir docker-compose.ollama.yml)
# EMBEDDINGS_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=paraphrase-multilingual
# EMBEDDINGS_TIMEOUT_MS=30000
